# HTTP API
HTTP_PORT=:8000
SHUTDOWN_TIMEOUT=20s
SWAGGER_DIR=/app/docs

# RabbitMQ: подключение и повторная доставка
AMQP_URL=amqp://guest:guest@queue:5672/
TASK_QUEUE_NAME=tasks
RETRY_DELAY=10s
MAX_RETRIES=5

# Файлы: общая папка API и воркера, размер загрузки
DATA_DIR=/data
MAX_UPLOAD_SIZE_MB=500

# FFmpeg
WATERMARK_PATH=/resources/watermark.png
FFMPEG_TIMEOUT=4m

# gRPC: сервер API и адрес подключения воркера
GRPC_PORT=:9090
GRPC_TARGET=app:9090
