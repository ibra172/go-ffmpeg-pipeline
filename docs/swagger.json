{
    "swagger": "2.0",
    "info": {
        "description": "Asynchronous video processing API using FFmpeg. Register and log in, then enter Bearer \u003ctoken\u003e in Authorize to access protected endpoints.",
        "title": "Media Pipeline App API",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:8000",
    "basePath": "/",
    "paths": {
        "/login": {
            "post": {
                "description": "Authenticates an existing user and returns a valid bearer token for protected routes.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login user",
                "parameters": [
                    {
                        "description": "User login payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User logged in successfully",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid username or password",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Creates a user account. Username: 3–30 ASCII letters, digits or underscores, starting with a letter; uniqueness is case-insensitive. Password: 8–72 bytes.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register new user",
                "parameters": [
                    {
                        "description": "User registration payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User registered successfully",
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON or registration parameters",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Username already exists",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/result/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the processing result as output path for a task when it is finished. For failed tasks, the API returns the error message instead of the output artifact.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "Get task result",
                "parameters": [
                    {
                        "type": "string",
                        "example": "123e4567-e89b-12d3-a456-426614174000",
                        "description": "Task ID in UUID format",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Task finished (see status field for success/error)",
                        "schema": {
                            "$ref": "#/definitions/task.TaskResultResponse"
                        }
                    },
                    "202": {
                        "description": "Task is still being processed",
                        "schema": {
                            "$ref": "#/definitions/task.TaskStatusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid UUID format",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Authentication required",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Task not found or belongs to another user",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/status/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns the current processing state of a task. The public status values are in_progress, ready, and error.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "Get task status",
                "parameters": [
                    {
                        "type": "string",
                        "example": "123e4567-e89b-12d3-a456-426614174000",
                        "description": "Task ID in UUID format",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Current task status",
                        "schema": {
                            "$ref": "#/definitions/task.TaskStatusResponse"
                        }
                    },
                    "202": {
                        "description": "Task is still processing",
                        "schema": {
                            "$ref": "#/definitions/task.TaskStatusResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid UUID format",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Authentication required",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Task not found or belongs to another user",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/task": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates a new media-processing job. The task is queued immediately and can be checked by its UUID through the status and result endpoints.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "task"
                ],
                "summary": "Create processing task",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Video file",
                        "name": "video",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "enum": [
                            "transcode",
                            "thumbnail",
                            "watermark"
                        ],
                        "type": "string",
                        "description": "Processing operation",
                        "name": "operation",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "enum": [
                            "mp4",
                            "mov",
                            "mkv",
                            "webm"
                        ],
                        "type": "string",
                        "description": "Required for transcode",
                        "name": "target_format",
                        "in": "formData"
                    },
                    {
                        "enum": [
                            "360p",
                            "480p",
                            "720p",
                            "1080p",
                            "4k"
                        ],
                        "type": "string",
                        "description": "Optional transcode resolution",
                        "name": "resolution",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Task created successfully",
                        "schema": {
                            "$ref": "#/definitions/task.CreateTaskResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid multipart form or task parameters",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Authentication required",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Invalid method",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/httpresp.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "example": "alice"
                }
            }
        },
        "auth.LoginResponse": {
            "type": "object",
            "properties": {
                "expires_at": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "password123"
                },
                "username": {
                    "type": "string",
                    "example": "alice"
                }
            }
        },
        "auth.RegisterResponse": {
            "type": "object",
            "properties": {
                "user_id": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "httpresp.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "description": "Error holds a public error message.",
                    "type": "string"
                }
            }
        },
        "task.CreateTaskResponse": {
            "type": "object",
            "properties": {
                "task_id": {
                    "description": "TaskID is the generated UUID of the created task.",
                    "type": "string"
                }
            }
        },
        "task.TaskResultResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "output_path": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "task.TaskStatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "description": "Status can be in_progress, ready, or error.",
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}